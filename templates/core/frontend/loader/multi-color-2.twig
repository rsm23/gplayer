<style>
    .dots-spinner-2 {
        --loader-size: clamp(12px, 3vmin, 24px);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: calc(var(--loader-size) * 0.5);
        margin: 0 auto;
        box-sizing: border-box;
    }

    .dots-spinner-2 div {
        width: var(--loader-size);
        height: var(--loader-size);
        background-color: {{ playerColor }};
        border-radius: 50%;
        animation: bounce 1.5s infinite ease-in-out;
        will-change: transform;
    }

    .dots-spinner-2 div:nth-child(2) {
        animation-delay: 0.2s;
    }

    .dots-spinner-2 div:nth-child(3) {
        animation-delay: 0.4s;
    }

    @keyframes bounce {
        0%,
        80% {
            transform: scale(0);
            -webkit-transform: scale(0);
        }
        100% {
            transform: scale(0);
            -webkit-transform: scale(0);
        }
        60% {
            background-color: {{ playerColor2 }};
            transform: scale(1);
            -webkit-transform: scale(1);
        }
        40% {
            background-color: {{ playerColor }};
            transform: scale(1);
            -webkit-transform: scale(1);
        }
    }
</style>
<div class="dots-spinner-2">
    <div></div>
    <div></div>
    <div></div>
</div>