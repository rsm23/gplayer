{% include templates.backend_header %}
<div class="row pt-3 mt-5">
    <div class="col-12">
        <h1 class="h4 mb-3">{{ title }}</h1>
        <div class="toolbar d-flex flex-wrap toolbar mb-3">
            <button type="button" class="btn btn-danger btn-hidden d-none" onclick="sessions.delete.multi()">
                <em class="fas fa-trash-alt mr-2"></em>Delete
            </button>
            <button type="button" class="btn btn-info" onclick="sessions.reload()">
                <em class="fas fa-sync-alt mr-2"></em>Reload
            </button>
        </div>
        <table id="tbSessions" class="table table-striped table-bordered table-hover m-0 w-100" aria-label="User Session List">
            <thead>
                <tr>
                    <th scope="col" data-priority="0" style="width:64px!important">
                        <div class="custom-control custom-checkbox mx-auto">
                            <input type="checkbox" class="custom-control-input" id="ckAllSessions" data-tableid="#tbSessions">
                            <label class="custom-control-label" for="ckAllSessions" aria-label="Check All"></label>
                        </div>
                    </th>
                    <th scope="col" data-priority="1">Username</th>
                    <th scope="col" data-priority="2">IP</th>
                    <th scope="col" data-priority="4">UA</th>
                    <th scope="col" data-priority="5">Created</th>
                    <th scope="col" data-priority="6">Expires</th>
                    <th scope="col" data-priority="3">Actions</th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th scope="col" data-priority="0" style="width:64px!important">
                        <div class="custom-control custom-checkbox mx-auto">
                            <input type="checkbox" class="custom-control-input" id="ckAllSessions1">
                            <label class="custom-control-label" for="ckAllSessions1" aria-label="Check All"></label>
                        </div>
                    </th>
                    <th scope="col" data-priority="1">Username</th>
                    <th scope="col" data-priority="2">IP</th>
                    <th scope="col" data-priority="4">UA</th>
                    <th scope="col" data-priority="5">Created</th>
                    <th scope="col" data-priority="6">Expires</th>
                    <th scope="col" data-priority="3">Actions</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
{# Plugin Widget Slot: page bottom #}
{{ render_slot('backend.users.sessions.bottom') }}

{% include templates.backend_footer %}