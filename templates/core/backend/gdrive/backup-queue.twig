{% include templates.backend_header %}
<div class="row pt-3 mt-5">
	<div class="col-12">
		<h1 class="h4 mb-3">{{ title }}</h1>
		<div class="toolbar d-flex flex-wrap mb-3 toolbar">
			<button type="button" class="btn btn-danger btn-hidden d-none" onclick="gdrive_backup_queue.delete.multi()">
				<em class="fas fa-trash-alt mr-2"></em>Delete
			</button>
			<button type="button" class="btn btn-info" onclick="gdrive_backup_queue.reload()">
				<em class="fas fa-sync-alt mr-2"></em>Reload
			</button>
		</div>
		<table id="tbGDBackupQueue" aria-label="Google Drive Queue" class="table table-striped table-bordered table-hover m-0 w-100">
			<thead>
				<tr>
					<th scope="col" data-priority="0" style="width:64px!important">
						<div class="custom-control custom-checkbox mx-auto">
							<input type="checkbox" class="custom-control-input" id="ckAllGDQF" data-tableid="#tbGDBackupQueue">
							<label class="custom-control-label" for="ckAllGDQF" aria-label="Check All"></label>
						</div>
					</th>
					<th scope="col" data-priority="1">File ID</th>
					<th scope="col" data-priority="2">Actions</th>
				</tr>
			</thead>
			<tfoot>
				<tr>
					<th scope="col" data-priority="0" style="width:64px!important">
						<div class="custom-control custom-checkbox mx-auto">
							<input type="checkbox" class="custom-control-input" id="ckAllGDQF1" data-tableid="#tbGDBackupQueue">
							<label class="custom-control-label" for="ckAllGDQF1" aria-label="Check All"></label>
						</div>
					</th>
					<th scope="col" data-priority="1">File ID</th>
					<th scope="col" data-priority="2">Actions</th>
				</tr>
			</tfoot>
		</table>
	</div>
</div>
{# Plugin Widget Slot: page bottom #}
{{ render_slot('backend.gdrive.backup_queue.bottom') }}

{% include templates.backend_footer %}