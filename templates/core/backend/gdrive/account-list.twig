{% include templates.backend_header %}
<div class="row pt-3 mt-5">
	<div class="col-12">
		<h1 class="h4 mb-3">{{ title }}</h1>
		<p>You can add a Google Drive account from this menu without creating a json file manually.</p>
		<div class="toolbar d-flex flex-wrap toolbar mb-3">
			<a href="{{ backend_url }}gdrive/new/" class="btn btn-success">
				<em class="fas fa-plus-circle mr-2"></em>Add New
			</a>
			<button type="button" class="btn btn-danger btn-hidden d-none" onclick="gdrive_accounts.delete.multi()">
				<em class="fas fa-trash-alt mr-2"></em>Delete
			</button>
			<button type="button" class="btn btn-info" onclick="gdrive_accounts.reload()">
				<em class="fas fa-sync-alt mr-2"></em>Reload
			</button>
		</div>
		<table id="tbGDAccounts" class="table table-striped table-bordered table-hover m-0 w-100" aria-label="Google Drive Account List">
			<thead>
				<tr>
					<th scope="col" data-priority="0" style="width:64px!important">
						<div class="custom-control custom-checkbox mx-auto">
							<input type="checkbox" class="custom-control-input" id="ckAllGDA" data-tableid="#tbGDAccounts">
							<label class="custom-control-label" for="ckAllGDA" aria-label="Check All"></label>
						</div>
					</th>
					<th scope="col" data-priority="1">Email</th>
					<th scope="col" data-priority="3">Bypass</th>
					<th scope="col" data-priority="4">Status</th>
					<th scope="col" data-priority="5">Created</th>
					<th scope="col" data-priority="6">Updated</th>
					<th scope="col" data-priority="2">Actions</th>
				</tr>
			</thead>
			<tfoot>
				<tr>
					<th scope="col" data-priority="0" style="width:64px!important">
						<div class="custom-control custom-checkbox mx-auto">
							<input type="checkbox" class="custom-control-input" id="ckAllGDA1" data-tableid="#tbGDAccounts">
							<label class="custom-control-label" for="ckAllGDA1" aria-label="Check All"></label>
						</div>
					</th>
					<th scope="col" data-priority="1">Email</th>
					<th scope="col" data-priority="3">Bypass</th>
					<th scope="col" data-priority="4">Status</th>
					<th scope="col" data-priority="5">Created</th>
					<th scope="col" data-priority="6">Updated</th>
					<th scope="col" data-priority="2">Actions</th>
				</tr>
			</tfoot>
		</table>
	</div>
</div>
{# Plugin Widget Slot: page bottom #}
{{ render_slot('backend.gdrive.list.bottom') }}

{% include templates.backend_footer %}