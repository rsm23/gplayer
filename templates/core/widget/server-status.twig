<div class="card">
    <div class="card-header">
        <h6 class="mb-0">
            <em class="fas fa-server mr-2"></em>Server Status Monitor
        </h6>
    </div>
    <div class="card-body" id="statusCardBody">
        <div class="alert alert-danger d-none">Failed to fetch server status</div>
        <div class="row">
            <div class="col-md-4 mb-4 text-center border-right">
                <h6 class="font-weight-bold mb-2">
                    <i class="fas fa-microchip mr-1"></i>CPU Usage
                </h6>
                <div id="statusCpuValue" class="h3 font-weight-bold mb-3">0%</div>
                <div class="progress" style="height: 10px;">
                    <div id="statusCpuProgress" class="progress-bar bg-success" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
            <div class="col-md-4 mb-4 text-center border-right">
                <h6 class="font-weight-bold mb-2">
                    <i class="fas fa-memory mr-1"></i>RAM Usage
                </h6>
                <div id="statusRamPercent" class="h3 font-weight-bold mb-1">0%</div>
                <small id="statusRamText" class="d-block mb-2">0 GB / 0 GB</small>
                <div class="progress" style="height: 10px;">
                    <div id="statusRamProgress" class="progress-bar bg-success" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
            <div class="col-md-4 mb-4 text-center">
                <h6 class="font-weight-bold mb-2">
                    <i class="fas fa-hdd mr-1"></i>Disk Usage
                </h6>
                <div id="statusDiskPercent" class="h3 font-weight-bold mb-1">0%</div>
                <small id="statusDiskText" class="d-block mb-2">0 GB / 0 GB</small>
                <div class="progress" style="height: 10px;">
                    <div id="statusDiskProgress" class="progress-bar bg-success" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
        <hr>
        <h6 class="font-weight-bold mb-3">
            <i class="fas fa-tasks mr-1"></i>System Services &amp; Info
        </h6>
        <div class="form-row">
            <div class="col-md-6">
                <div class="d-flex align-items-center justify-content-between p-2 border rounded mb-2">
                    <div class="font-weight-bold">
                        <img src="data:image/svg+xml;base64," alt="Apache" height="20" class="mr-2">Apache
                    </div>
                    <span id="service_apache_badge" class="badge badge-danger p-2">Stopped</span>
                </div>
                <div class="d-flex align-items-center justify-content-between p-2 border rounded mb-2">
                    <div class="font-weight-bold">
                        <img src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIiB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCI+PHBhdGggZD0iTTY1IDE1TDI1IDU1aDI1TDM1IDkwbDQ1LTQ1SDU1eiIgZmlsbD0iIzFBQzQwMCIgc3Ryb2tlPSIjMDAzNTgwIiBzdHJva2Utd2lkdGg9IjQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=" alt="LiteSpeed" class="mr-2" width="20">LiteSpeed
                    </div>
                    <span id="service_litespeed_badge" class="badge badge-danger p-2">Stopped</span>
                </div>
                <div class="d-flex align-items-center justify-content-between p-2 border rounded mb-2">
                    <div class="font-weight-bold">
                        <img src="data:image/svg+xml;base64," alt="NGINX" height="20" class="mr-2">NGINX
                    </div>
                    <span id="service_nginx_badge" class="badge badge-danger p-2">Stopped</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex align-items-center justify-content-between p-2 border rounded mb-2">
                    <div class="font-weight-bold">
                        <img src="data:image/svg+xml;base64," alt="Memcached" width="20" class="mr-2">Memcached
                    </div>
                    <span id="service_memcached_badge" class="badge badge-danger p-2">Stopped</span>
                </div>
                <div class="d-flex align-items-center justify-content-between p-2 border rounded mb-2">
                    <div class="font-weight-bold">
                        <img class="mr-2" alt="Redis" width="20" src="data:image/svg+xml;base64,">Redis
                    </div>
                    <span id="service_redis_badge" class="badge badge-danger p-2">Stopped</span>
                </div>
                <div class="d-flex align-items-center justify-content-between p-2 border rounded mb-2">
                    <div>
                        <img class="mr-2" alt="PHP" height="20" src="data:image/svg+xml;base64,">
                        <strong>PHP:</strong> <span id="service_php_name">N/A</span>,
                        <strong>memory_limit:</strong> <span id="service_php_limit">N/A</span>
                    </div>
                    <span id="service_php_badge" class="badge badge-danger p-2">Stopped</span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="d-flex align-items-center justify-content-between p-2 border rounded mb-2">
                    <div>
                        <img src="data:image/svg+xml;base64," alt="cURL" width="20" class="mr-2">
                        <strong>cURL:</strong> <span id="service_php_curl">N/A</span>,
                        <strong>SSL:</strong> <span id="service_php_ssl">N/A</span>,
                        <strong>Brotli:</strong> <span id="service_php_brotli">N/A</span>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between p-2 border rounded mb-2">
                    <div>
                        <strong>OS:</strong> <span id="statusOS">N/A</span>,
                        <strong>Uptime:</strong> <span id="statusUptime">0 hours</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% if link is defined and link is not empty %}
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            let lbStatus = setInterval(function() {
                if (typeof load_balancers !== "undefined") {
                    // Initial load
                    load_balancers.loadStatusCard('{{ link }}', $('#btnLoadStatusServer'));
                    clearInterval(lbStatus);
                }
            }, 500);
        });
    </script>
{% endif %}