NODE_ENV=development
HOST=127.0.0.1
PORT=3000
BASE_URL=http://127.0.0.1:3000/
ADMIN_DIR=administrator
SLUG_EMBED=e
SLUG_DOWNLOAD=d
SLUG_REQUEST=r
SECURE_SALT=replace-with-a-long-random-secret
BUFFER_SIZE=1024000
SMALL_BUFFER_SIZE=512000
MAX_DOWNLOAD_SPEED=0
# False by default. Set an explicit reverse-proxy IP/CIDR list when deployed behind a trusted proxy.
TRUST_PROXY=false
DB_MASTER_HOST=127.0.0.1
DB_MASTER_PORT=3306
DB_MASTER_NAME=gplayer
DB_MASTER_USER=root
DB_MASTER_PASSWORD=
# Optional for the schema migration/audit utilities on socket-authenticated local databases.
DB_MASTER_SOCKET=
DB_REPLICA_HOST=127.0.0.1
DB_REPLICA_PORT=3306
DB_REPLICA_NAME=gplayer
DB_REPLICA_USER=root
DB_REPLICA_PASSWORD=
DB_CONNECT_TIMEOUT_MS=10000
DB_CONNECTION_LIMIT=10
