{
  "name": "gplayer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Self-hosted Node.js media player and streaming gateway for provider links, HLS, DASH, and MP4.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm build:ui && tsc -p tsconfig.build.json",
    "build:ui": "pnpm build:static-ui && tailwindcss -i src/styles/globals.css -o public/assets/css/gplayer-ui.css --minify",
    "build:static-ui": "tsx tools/build-static-ui.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "audit:schema": "node tools/audit-schema.mjs",
    "assets:migrate": "tsx tools/migrate-legacy-assets.ts",
    "db:migrate": "tsx tools/migrate-database.ts",
    "inspect:legacy-php": "node tools/inspect-yakpro-php.mjs",
    "sync:legacy-assets": "node tools/sync-legacy-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "8.0.2",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dom-serializer": "3.1.1",
    "dotenv": "17.4.2",
    "fastify": "5.11.2",
    "html-react-parser": "6.1.5",
    "lucide-react": "1.28.0",
    "maxmind": "5.0.7",
    "mysql2": "3.23.2",
    "nodemailer": "9.0.4",
    "png-to-ico": "3.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "sqids": "0.3.0",
    "tailwind-merge": "3.6.0",
    "youtubei.js": "17.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.1.2",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
