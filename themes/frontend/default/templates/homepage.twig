{% include 'elements/header.twig' %}
<!-- Hero Section -->
<div class="row bg-custom text-center shadow-sm" style="border-radius: 0 0 20px 20px">
    <div class="col py-5">
        <h1 class="h3">{{ site_slogan|raw }}</h1>
        <p>{{ site_description|raw }}</p>
    </div>
</div>
<!-- Player Section -->
<div id="createVideoPlayer" class="row mt-3">
	<div class="col-12">
		<div class="card mb-3 shadow-sm">
			<div class="h6 card-header mb-0">
				<i class="fas fa-film text-primary mr-2"></i> Player Configuration
			</div>
			<div class="card-body">
				{% include templates.player_form %}
			</div>
		</div>
		<div id="createPlayerResult" class="d-none card mb-3 shadow-sm">
			<div class="h6 card-header">
				<i class="fas fa-play text-success mr-2"></i> Generated Output &amp; Preview
			</div>
			<div class="card-body">
				{% include templates.player_result %}
			</div>
		</div>
		{% include templates.link_examples %}
		{% include templates.disqus %}
	</div>
</div>
{% include 'elements/footer.twig' %}
