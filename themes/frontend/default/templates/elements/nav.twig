{% set currentUrl = current_url()|default('/') %}
<nav class="shadow navbar navbar-expand-lg container-xl fixed-top bg-custom navbar-dark">
    <a class="navbar-brand" href="{{ base_url }}">{{ site_name }}</a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse navbar-nav-scroll" id="navbarCollapse" style="max-height:calc(100vh - 56px)">
        <ul class="ml-auto navbar-nav">
            <li class="nav-item {{ currentUrl == '/' ? 'active' : '' }}">
                <a class="nav-link" href="{{ base_url }}">
                    <i class="fas fa-home mr-2"></i>Home
                </a>
            </li>
            {% if enable_gsharer %}
                <li class="nav-item {{ str_contains(currentUrl, '/sharer') ? 'active' : '' }}">
                    <a class="nav-link" href="{{ base_url }}sharer/">
                        <i class="fab fa-google-drive mr-2"></i>Bypass Limit
                    </a>
                </li>
            {% endif %}
            {% if user_detail is not empty %}
                <li class="nav-item dropdown">
                    <a class="dropdown-toggle nav-link" href="javascript:void(0)" data-toggle="dropdown" aria-expanded="false" rel="noopener">
                        <i class="fas fa-user-circle mr-2"></i>User Panel
                    </a>
                    <ul class="dropdown-menu shadow border-0">
                        <li>
                            <a class="dropdown-item" href="{{ backend_url }}dashboard/" title="Dashboard" rel="noopener">
                                <i class="fas fa-tachometer-alt mr-2"></i>Dashboard </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ backend_url }}videos/list/" title="My Videos" rel="noopener">
                                <i class="fas fa-film mr-2"></i>My Videos </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ backend_url }}profile/" title="My Account" rel="noopener">
                                <i class="fas fa-user mr-2"></i>My Account </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ backend_url }}login/?logout=true" title="Logout" rel="noopener">
                                <i class="fas fa-sign-out-alt mr-2"></i>Logout </a>
                        </li>
                    </ul>
                </li>
            {% elseif enable_registration %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ backend_url }}login/">
                        <i class="fas fa-sign-in-alt mr-2"></i>Login
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ backend_url }}register/">
                        <i class="fas fa-user-plus mr-2"></i>Register
                    </a>
                </li>
            {% endif %}
            <li class="nav-item dropdown">
                <a class="dropdown-toggle nav-link" href="javascript:void(0)" data-toggle="dropdown" aria-expanded="false" rel="noopener">
                    <i class="mr-2 fas fa-{{ is_dark_mode ? 'moon' : 'sun' }} ico-theme"></i>
                    <span class="theme-label">{{ is_dark_mode ? 'Dark' : 'Light' }}</span>
                </a>
                <ul class="border-0 shadow dropdown-menu dropdown-menu-right">
                    <li>
                        <button class="dropdown-item" onclick="changeMode('light')">
                            <i class="mr-2 fas fa-sun"></i>Light
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" onclick="changeMode('dark')">
                            <i class="mr-2 fas fa-moon"></i>Dark
                        </button>
                    </li>
                </ul>
            </li>
        </ul>
    </div>
</nav>