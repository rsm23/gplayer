{% set currentUrl = current_url()|default('/') %}
<nav class="shadow navbar navbar-expand-xl container-xl fixed-top bg-custom navbar-dark">
    <a class="navbar-brand" href="{{ base_url }}">{{ site_name }}</a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse navbar-nav-scroll" id="navbarCollapse" style="max-height:calc(100vh - 56px)">
		{% if user_detail is empty %}
			<ul class="ml-auto navbar-nav">
				<li class="nav-item {{ currentUrl == '/' ? 'active' : '' }}">
					<a class="nav-link" href="{{ base_url }}">
						<i class="fas fa-home mr-2"></i>Home
					</a>
				</li>
				{% if enable_registration %}
					<li class="nav-item {{ str_contains(currentUrl, '/login') ? 'active' : '' }}">
						<a class="nav-link" href="{{ backend_url }}login/">
							<i class="fas fa-sign-in-alt mr-2"></i>Login
						</a>
					</li>
					<li class="nav-item {{ str_contains(currentUrl, '/register') ? 'active' : '' }}">
						<a class="nav-link" href="{{ backend_url }}register/">
							<i class="fas fa-user-plus mr-2"></i>Register
						</a>
					</li>
					<li class="nav-item {{ str_contains(currentUrl, '/reset') ? 'active' : '' }}">
						<a class="nav-link" href="{{ backend_url }}reset-password/">
							<i class="fas fa-sync-alt mr-2"></i>Reset Password
						</a>
					</li>
				{% endif %}
				<li class="nav-item dropdown">
					<a class="dropdown-toggle nav-link" href="javascript:void(0)" data-toggle="dropdown" aria-expanded="false" rel="noopener">
						<i class="mr-2 fas fa-{{ is_dark_mode ? 'moon' : 'sun' }} ico-theme"></i>
						<span class="theme-label">{{ is_dark_mode ? 'Dark' : 'Light' }}</span>
					</a>
					<ul class="border-0 shadow dropdown-menu">
						<li>
							<button class="dropdown-item" onclick="changeMode('light')">
								<i class="mr-2 fas fa-sun"></i>Light
							</button>
						</li>
						<li>
							<button class="dropdown-item" onclick="changeMode('dark')">
								<i class="mr-2 fas fa-moon"></i>Dark
							</button>
						</li>
					</ul>
				</li>
			</ul>
		{% else %}
			<ul class="navbar-nav">
				<li class="nav-item">
					<a class="nav-link" href="{{ base_url }}">
						<i class="fas fa-home mr-2"></i><span class="d-xl-none">Home</span>
					</a>
				</li>
				<li class="nav-item {{ str_contains(currentUrl, '/dashboard') ? 'active' : '' }}">
					<a class="nav-link" href="{{ backend_url }}dashboard/">
						<i class="fas fa-tachometer-alt mr-2"></i>Dashboard</a>
				</li>
				<li class="nav-item dropdown {{ str_contains(currentUrl, '/videos') ? 'active' : '' }}">
					<a class="dropdown-toggle nav-link" href="javascript:void(0)" data-toggle="dropdown" aria-expanded="false" rel="noopener">
						<i class="fas fa-film mr-2"></i>Videos</a>
					<ul class="dropdown-menu shadow border-0">
						<li>
							<a class="dropdown-item" href="{{ backend_url }}videos/new/" title="Add New Video" rel="noopener">
								<i class="fas fa-plus-circle mr-2"></i>Add New Video</a>
						</li>
						<li>
							<hr class="dropdown-divider">
						</li>
						<li>
							<a class="dropdown-item" href="{{ backend_url }}videos/list/" title="Video List" rel="noopener">
								<i class="fas fa-film mr-2"></i>Video List</a>
						</li>
						<li>
							<a class="dropdown-item" href="{{ backend_url }}videos/subtitles/" title="Subtitle Manager" rel="noopener">
								<i class="fas fa-copy mr-2"></i>Subtitle Manager</a>
						</li>
					</ul>
				</li>
				{% if is_admin %}
					<li class="nav-item dropdown {{ str_contains(currentUrl, '/gdrive') ? 'active' : '' }}">
						<a class="dropdown-toggle nav-link" href="javascript:void(0)" data-toggle="dropdown" aria-expanded="false" rel="noopener">
							<i class="fab fa-google-drive mr-2"></i>Google Drive</a>
						<ul class="dropdown-menu shadow border-0">
							<li>
								<a class="dropdown-item" href="{{ backend_url }}gdrive/new/" title="Add New Account" rel="noopener">
									<i class="fas fa-plus-circle mr-2"></i>Add New Account</a>
							</li>
							<li>
								<hr class="dropdown-divider">
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}gdrive/list/" title="Account List" rel="noopener">
									<i class="fas fa-key text-right mr-2"></i>Account List</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}gdrive/files/" title="File List" rel="noopener">
									<i class="fas fa-copy mr-2"></i>File List</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}gdrive/backup-files/" title="Backup File List" rel="noopener">
									<i class="fas fa-clone mr-2"></i>Backup File List</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}gdrive/backup-queue/" title="Backup Queue List" rel="noopener">
									<i class="fas fa-calendar-check mr-2"></i>Backup Queue List</a>
							</li>
						</ul>
					</li>
					<li class="nav-item dropdown {{ str_contains(currentUrl, '/users') ? 'active' : '' }}">
						<a class="dropdown-toggle nav-link" href="javascript:void(0)" data-toggle="dropdown" aria-expanded="false" rel="noopener">
							<i class="fas fa-users mr-2"></i>Users</a>
						<ul class="dropdown-menu shadow border-0">
							<li>
								<a class="dropdown-item" href="{{ backend_url }}users/new/" title="Add New User" rel="noopener">
									<i class="fas fa-plus-circle mr-2"></i>Add New User</a>
							</li>
							<li>
								<hr class="dropdown-divider">
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}users/list/" title="User List" rel="noopener">
									<i class="fas fa-users mr-2"></i>User List</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}users/sessions/" title="Session List" rel="noopener">
									<i class="fas fa-history mr-2"></i>Session List</a>
							</li>
						</ul>
					</li>
					<li class="nav-item {{ str_contains(currentUrl, '/plugins') ? 'active' : '' }}">
						<a class="nav-link" href="{{ backend_url }}plugins/list">
							<i class="fas fa-box mr-2"></i>Plugins</a>
					</li>
					<li class="nav-item dropdown {{ str_contains(currentUrl, 'settings') or str_contains(currentUrl, 'balancers') or str_contains(currentUrl, 'log') ? 'active' : '' }}">
						<a class="dropdown-toggle nav-link" href="javascript:void(0)" data-toggle="dropdown" aria-expanded="false" rel="noopener">
							<i class="fas fa-gear mr-2"></i>App</a>
						<ul class="dropdown-menu shadow border-0">
							<li class="dropdown-header font-weight-bolder">
								<i class="fas fa-server mr-2"></i>Load Balancer
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}load-balancers/list/" title="Servers" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>Servers</a>
							</li>
							<li>
								<hr class="dropdown-divider">
							</li>
							<li class="dropdown-header font-weight-bolder">
								<i class="fas fa-gear mr-2"></i>Settings
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}settings/site/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>Site</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}settings/general/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>General</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}settings/public/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>Public</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}settings/player/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>Player</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}settings/ads/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>Ads</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}settings/shortlink/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>Shortlink</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}settings/smtp/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>SMTP</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}settings/hosting/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>Hosting</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}settings/misc/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>Misc</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}settings/custom-headers/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>Custom Headers</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}log/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>Log Viewer</a>
							</li>
							<li>
								<hr class="dropdown-divider">
							</li>
							<li>
								<a class="dropdown-item" href="{{ backend_url }}settings/reset/" rel="noopener">
									<i class="fas fa-angle-double-right text-right mr-2"></i>Reset</a>
							</li>
						</ul>
					</li>
				{% endif %}
				<li class="nav-item dropdown">
					<a class="dropdown-toggle nav-link" href="javascript:void(0)" data-toggle="dropdown" aria-expanded="false" rel="noopener">
						<i class="mr-2 fas fa-{{ is_dark_mode ? 'moon' : 'sun' }} ico-theme"></i>
						<span class="theme-label">{{ is_dark_mode ? 'Dark' : 'Light' }}</span>
					</a>
					<ul class="border-0 shadow dropdown-menu dropdown-menu-right">
						<li>
							<button class="dropdown-item" onclick="changeMode('light')">
								<i class="mr-2 fas fa-sun"></i>Light
							</button>
						</li>
						<li>
							<button class="dropdown-item" onclick="changeMode('dark')">
								<i class="mr-2 fas fa-moon"></i>Dark
							</button>
						</li>
					</ul>
				</li>
			</ul>
			<ul class="navbar-nav ml-auto">
				<li class="nav-item dropdown {{ str_contains(currentUrl, '/profile') ? 'active' : '' }}">
					<a class="dropdown-toggle nav-link" href="javascript:void(0)" data-toggle="dropdown" aria-expanded="false" rel="noopener">
						<i class="fas fa-user-circle mr-2"></i>{{ user_detail.name }}
					</a>
					<ul class="dropdown-menu shadow border-0 dropdown-menu-right">
						<li>
							<a class="dropdown-item" href="{{ backend_url }}profile/" title="My Account" rel="noopener">
								<i class="fas fa-user mr-2"></i>My Account
							</a>
						</li>
						<li>
							<hr class="dropdown-divider">
						</li>
						<li>
							<a class="dropdown-item" href="{{ backend_url }}login/?logout=true" title="Logout" rel="noopener">
								<i class="fas fa-sign-out-alt mr-2"></i>Logout
							</a>
						</li>
					</ul>
				</li>
			</ul>
		{% endif %}
    </div>
</nav>